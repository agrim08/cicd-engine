{
  "name": "@github-actions-clone/server",
  "version": "1.0.0",
  "private": true,
  "description": "API Server for GitHub Actions Clone",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "knex migrate:latest --knexfile src/storage/knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile src/storage/knexfile.ts -x ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/storage/knexfile.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.3.0",
    "@bull-board/express": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.18.1",
    "bullmq": "^5.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^5.2.1",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.6",
    "@types/socket.io": "^3.0.1",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
