# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://cicd:cicd@localhost:5432/cicd

# Redis configuration
REDIS_URL=redis://localhost:6379

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key
GITHUB_TOKEN=your_github_personal_access_token

# Cryptography / Security
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex string
RUNNER_JWT_SECRET=your_jwt_signing_secret_for_runners

# Cloudflare R2 Artifact Storage (AWS S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
