{
  "name": "github-actions-clone",
  "private": true,
  "workspaces": [
    "backend/server",
    "backend/runner",
    "frontend"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=backend/server",
    "dev:runner": "npm run dev --workspace=backend/runner",
    "build:server": "npm run build --workspace=backend/server",
    "build:runner": "npm run build --workspace=backend/runner"
  },
  "dependencies": {
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
